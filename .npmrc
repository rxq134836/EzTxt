# Electron 二进制下载镜像（GitHub 直连经常超时/失败，国内环境必备）
# npm 运行 electron postinstall 时会读取此配置并传给 @electron/get
electron_mirror=https://npmmirror.com/mirrors/electron/

# electron-builder 构建工具（NSIS / winCodeSign 等）下载镜像
# npm 运行 electron-builder 时自动作为 npm_config_electron_builder_binaries_mirror 传入
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
