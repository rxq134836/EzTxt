# 依赖
node_modules/

# npm 本地临时 cache(用 --cache .npm-cache 时)
.npm-cache/

# 构建产物
dist/
build/

# Electron 调试
out/

# 日志
*.log
npm-debug.log*

# 编辑器
.vscode/
.idea/

# 系统文件
Thumbs.db
Desktop.ini
.DS_Store

# 本地环境变量（GitHub Token 等）—— 禁止提交
.env
.env.local

# 运行时生成的本地数据（开发时）
storage/

# 本地数据文件（待办列表 + 设置）—— 不提交，避免每次运行后 git status 都出现改动
data/note.json
data/settings.json
